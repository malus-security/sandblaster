(version 1)
(allow default)
(deny file-issue-extension
	(regex #"^/private/var/containers/Data/System/[^/]+/[.]com[.]apple[.]")
	(require-all
		(extension "com.apple.sandbox.system-group")
		(require-any
			(require-entitlement "com.apple.security.system-group-containers")
			(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]")
			(require-entitlement "com.apple.security.system-groups")
			(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]")))
	(require-all
		(extension "com.apple.sandbox.executable")
		(regex #"/[^/]+/SC_Info/" #".+/[^/]+/SC_Info/"))
	(require-all
		(extension "com.apple.sandbox.system-container")
		(require-entitlement "com.apple.security.system-container")))
(deny file-mount)
(deny file-mount-update)
(deny file-read*
	(require-not (regex #"^/private/var/containers/Data/System/[^/]+/[.]com[.]apple[.]"))
	(require-all
		(require-all (require-not (subpath "/System/Library/Frameworks"))
(require-not (subpath "/System/Library/PrivateFrameworks")))
		(require-not (subpath "/private/var/preferences/Logging"))
		(require-not (subpath "/System/Library"))
		(require-not (subpath "/usr/lib"))
		(require-not (subpath "/usr/share"))
		(require-not (subpath "/private/var/db/timezone"))
		(require-all (require-not (literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/EffectiveUserSettings.plist"))
(require-not (literal-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/EffectiveUserSettings.plist"))
(require-not (literal-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/EffectiveUserSettings.plist")))
		(require-not (extension "com.apple.app-sandbox.read"))
		(require-not (extension "com.apple.security.exception.files.home-relative-path.read-only"))
		(require-not (subpath "/Developer"))
		(require-not (literal "/private/var/Managed Preferences/mobile/.GlobalPreferences.plist"))
		(require-not (literal-prefix "${FRONT_USER_HOME}/Library/Preferences/.GlobalPreferences.plist"))
		(require-not (extension "com.apple.app-sandbox.read-write"))
		(require-not (extension "com.apple.sandbox.executable"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-write"))
		(require-not (extension "com.apple.security.exception.files.home-relative-path.read-write"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-only"))
		(require-any
			(require-all
				(extension "com.apple.sandbox.system-group")
				(require-any
					(require-entitlement "com.apple.security.system-group-containers")
					(require-not (regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]"))
					(require-entitlement "com.apple.security.system-groups")
					(require-not (regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]"))))
			(require-all
				(require-all (require-not (literal "/dev/zero"))
(require-not (literal "/dev/null")))
				(require-all (require-not (subpath "/private/var/db/datadetectors/sys"))
(require-not (subpath "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.icloud.findmydevice.managed/Library")))
				(require-all (require-not (subpath "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/PublicInfo"))
(require-not (subpath-prefix "${FRONT_USER_HOME}/Library/ConfigurationProfiles/PublicInfo"))
(require-not (subpath-prefix "${FRONT_USER_HOME}/Library/UserConfigurationProfiles/PublicInfo")))
				(require-not (literal "/dev/dtracehelper"))
				(require-all (require-not (literal "/dev/urandom"))
(require-not (literal "/dev/random")))
				(require-not (literal "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist"))
				(require-not (literal "/dev/ptmx"))
				(require-not (literal "/dev/aes_0"))
				(require-any
					(require-not (vnode-type BLOCK-DEVICE))
					(require-not (vnode-type CHARACTER-DEVICE))))
			(require-all
				(extension "com.apple.sandbox.system-container")
				(require-entitlement "com.apple.security.system-container")))))
(deny file-read-data
	(require-all
		(extension "com.apple.sandbox.executable")
		(regex #"/[^/]+/SC_Info/" #".+/[^/]+/SC_Info/")))
(deny file-unmount)
(deny file-write*
	(regex #"^/private/var/containers/Data/System/[^/]+/[.]com[.]apple[.]")
	(require-all
		(require-not (literal "/private/var/db/PlugInKit-Annotations"))
		(require-not (subpath-prefix "${PROCESS_TEMP_DIR}"))
		(require-not (extension "com.apple.security.exception.files.absolute-path.read-write"))
		(require-not (extension "com.apple.security.exception.files.home-relative-path.read-write"))
		(require-not (extension "com.apple.app-sandbox.read-write"))
		(require-any
			(vnode-type BLOCK-DEVICE)
			(vnode-type CHARACTER-DEVICE)
			(require-all
				(extension "com.apple.sandbox.system-group")
				(require-any
					(require-entitlement "com.apple.security.system-group-containers")
					(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]")
					(require-entitlement "com.apple.security.system-groups")
					(regex #"^/private/var/containers/Shared/SystemGroup/[^/]+/[.]com[.]apple[.]")))
			(require-all
				(extension "com.apple.sandbox.system-container")
				(require-entitlement "com.apple.security.system-container")))))
(deny file-write-create
	(require-all
		(literal-prefix "${HOME}/Library/Caches/sharedCaches/com.apple.iTunesStore.NSURLCache")
		(require-entitlement "com.apple.itunesstored.private")))
(deny file-write-data
	(require-all
		(require-not (literal "/dev/ptmx"))
		(require-not (literal "/dev/aes_0"))
		(require-any (literal "/dev/urandom")
(literal "/dev/random"))))
(deny file-write-setugid)
(deny job-creation)
(deny nvram*)
(deny nvram-delete)
(deny nvram-get)
(deny nvram-set)
(deny process-info*)
(deny process-info-listpids)
