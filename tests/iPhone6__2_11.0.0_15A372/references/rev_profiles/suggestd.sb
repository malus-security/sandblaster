		(subpath-prefix "${HOME}/Library/Caches/com.apple.suggestd"))
	(require-all
		(extension-class "com.apple.mediaserverd.read")
		(regex #"^/private/var/containers/Data/System/[^/]+/" #"^/private/var/containers/Data/System/[^/]+$"))
